# Copy this file to .env in the project root before development or building.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: custom endpoint for S3-compatible object storage.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Optional: temporary credentials and the default upload folder.
S3_SESSION_TOKEN=
S3_KEY_PREFIX=

# Optional: public/CDN base URL pointing to the bucket root (without object key).
# Leave empty to derive the file URL from the S3 endpoint.
# To generate https://endpoint/key without a bucket name, set this to that public endpoint.
S3_PUBLIC_BASE_URL=

# Optional: comma-separated connection IPs; requires S3_ENDPOINT when set.
S3_CONNECT_IPS=

# Optional: upload stall grace period in seconds (20-300, default 60).
S3_STALL_GRACE_SECONDS=60

# Optional: multipart size in MiB (5-64) and concurrent uploads (1-8).
S3_PART_SIZE_MIB=64
S3_UPLOAD_CONCURRENCY=3

# Optional: send checksum headers (true or false, default true).
S3_SEND_CHECKSUM_HEADERS=true
